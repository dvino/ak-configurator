# AK Configurator AK820 hidraw access v1
# The application installer adds the current user's numeric group id. The
# packaged rule relies on logind's uaccess ACL for the active local session.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="320f", ATTRS{idProduct}=="505b", MODE="0660", TAG+="uaccess"
